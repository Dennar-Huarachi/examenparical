{
    "$schema": "https://railway.app/railway.schema.json",
    "deploy": {
        "numReplicas": 1,
        "startCommand": "sh -c 'php artisan migrate --force && php -S 0.0.0.0:${PORT:-8080} -t public vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php'",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
